# NOTE: this file is not actually read by the app (see .dev.vars.example).
# All routes get secrets via getRequestContext().env, which is populated
# from `.dev.vars`, not from Next.js's normal env loading. Use
# `.dev.vars.example` instead for local dev. Kept here only as a reference
# for what NEXTAUTH_URL / redirect URI should be.

# --- Auth.js core ---
AUTH_SECRET=replace_with_openssl_rand_base64_32_output
NEXTAUTH_URL=http://localhost:8788

# --- LinkedIn OAuth provider ---
# Redirect URI: http://localhost:8788/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# --- OpenAI ---
OPENAI_API_KEY=sk-replace-with-your-key
